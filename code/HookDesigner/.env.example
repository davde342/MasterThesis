# Copy this file to .env and configure your paths

# MSVC Configuration
VCVARS64_PATH=C:\Program Files\Microsoft Visual Studio\2022\Community\VC\Auxiliary\Build\vcvars64.bat
VCVARS32_PATH=C:\Program Files\Microsoft Visual Studio\2022\Community\VC\Auxiliary\Build\vcvars32.bat

# Microsoft Detours Configuration
DETOURS_INC=C:\Detours\Detours-main\include
DETOURS_LIB_X64=C:\Detours\Detours-main\lib.X64\detours.lib
DETOURS_LIB_X86=C:\Detours\Detours-main\lib.X86\detours.lib

# Frida-Gum Configuration
FRIDA_INC_X64=C:\Path\To\Frida\x64
FRIDA_LIB_X64=C:\Path\To\Frida\x64\frida-gum.lib
FRIDA_INC_X86=C:\Path\To\Frida\x86
FRIDA_LIB_X86=C:\Path\To\Frida\x86\frida-gum.lib

# Telemetry Configuration (spdlog & prometheus-cpp)
SPDLOG_INC=C:\Path\To\spdlog\include
PROMETHEUS_INC=C:\Path\To\prometheus-cpp\core\include,C:\Path\To\prometheus-cpp\pull\include
PROMETHEUS_LIBS_X64=C:\Path\To\prometheus-cpp\lib64\prometheus-cpp-core.lib,C:\Path\To\prometheus-cpp\lib64\prometheus-cpp-pull.lib,C:\Path\To\prometheus-cpp\lib64\civetweb.lib
PROMETHEUS_LIBS_X86=C:\Path\To\prometheus-cpp\lib32\prometheus-cpp-core.lib,C:\Path\To\prometheus-cpp\lib32\prometheus-cpp-pull.lib,C:\Path\To\prometheus-cpp\lib32\civetweb.lib

# LLVM/Clang libclang Path
LIBCLANG_PATH=

